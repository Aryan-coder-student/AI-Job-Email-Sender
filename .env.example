# Groq LLM API keys (at least one required)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI / Gemini LLM (optional fallbacks)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# GitHub API token for README fetching
GITHUB_TOKEN=

# Logging
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# Mail (gmail | outlook | custom)
MAIL_PROVIDER=gmail
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_FROM_EMAIL=  # defaults to SMTP_USERNAME
# SMTP_HOST=          # required when MAIL_PROVIDER=custom
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_TIMEOUT_SECONDS=30

# Knowledge graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Vector store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PROJECTS=projects
QDRANT_COLLECTION_JOBS=job_openings

# Embeddings (openai | gemini)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Hybrid matching weights
HYBRID_GRAPH_WEIGHT=0.4
HYBRID_VECTOR_WEIGHT=0.3
HYBRID_LLM_WEIGHT=0.3

# Redis (email draft queue)
REDIS_URL=redis://localhost:6379/2
EMAIL_QUEUE_KEY=email:queue:pending
EMAIL_SEND_RATE_LIMIT=10
EMAIL_SEND_RATE_WINDOW_SECONDS=60

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
